<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
    <DebugType>embedded</DebugType>

    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Translations the host reads off disk from the plugin folder at runtime. -->
    <Content Include="strings.*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Plugin icon, read from the assembly so it does not depend on the install layout. -->
    <EmbeddedResource Include="icon.png" LogicalName="LoupixDeck.Plugin.Audio.icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LoupixDeck.PluginSdk" Version="1.28.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- The NAudio meta package pulls these in, but neither NAudio.dll nor anything this plugin
         uses references them; leaving their assemblies out keeps them out of the release zip.
         NAudio.WinMM stays: AudioFileReader in NAudio.dll uses it (ACM for compressed wav). -->
    <PackageReference Include="NAudio.Asio" Version="2.2.1" ExcludeAssets="all" />
    <PackageReference Include="NAudio.Midi" Version="2.2.1" ExcludeAssets="all" />
  </ItemGroup>

</Project>
